datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// The Better Auth `user` model (see src/lib/auth.js): the player id is the single stable identity,
// and `callsign` doubles as Better Auth's `name`.
model Player {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  // Argon2id (or a legacy SHA-256 digest awaiting upgrade). "!" matches no hash format, so guests
  // and dev-login pilots cannot sign in with a password.
  passwordHash String        @default("!")
  callsign     String        @unique
  emailVerified Boolean      @default(false)
  image        String?
  // True until the guest links a real account; email is then a placeholder.
  isAnonymous  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  harbor       SpaceHarbor?
  session      GameSession?
  spaceships   Spaceship[]
  credits      Int           @default(0)
  // Set when development login grants the pilot its one-time starting credits; never granted twice.
  devCreditsGrantedAt DateTime?
  trades       TradeTransaction[]
  activeMissions   PlayerMission[]
  missionCooldowns MissionCooldown[]
  completedMissions CompletedMission[]
  abandonedMissions AbandonedMission[]
  reputations  PlayerReputation[]
  cargoLeases  CargoLease[]
  cargoSales   CargoSale[]
  planetCharts PlanetChart[]
  systemCharts SystemChart[]
  authSessions AuthSession[]
  accounts     Account[]
  refreshTokens RefreshToken[]
  guestDevice  GuestDevice?
}

model SpaceHarbor {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Geographical representation for real-world home anchor points [1, 2]
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  h3Index    String   @db.VarChar(15) // Uber H3 Resolution 8 or 9 index string

  level      Int      @default(1)
  metalStock Float    @default(0.0)
  gasStock   Float    @default(0.0)
  updatedAt  DateTime @updatedAt
}

model GameSession {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rtseHost   String   // Internal domain/service of the allocated RTSE instance [3]
  connected  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Spaceship {
  id         String                @id @default(uuid()) @db.Uuid
  playerId   String                @db.Uuid
  player     Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  callsign   String
  active     Boolean               @default(true)
  // Passengers currently aboard; bounded by the life support's passenger_capacity (never above it).
  passengersAboard Int             @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  components ShipComponentRecord[]
}

model ShipComponentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  spaceshipId String    @db.Uuid
  spaceship   Spaceship @relation(fields: [spaceshipId], references: [id], onDelete: Cascade)
  type        String    // HULL, RADAR, CARGO, STEALTH, SHIELDS, WEAPONS, ENERGY, COMMS, ENGINES
  tier        Int       @default(1)
  healthPct   Int       @default(100)
  updatedAt   DateTime  @updatedAt

  @@unique([spaceshipId, type])
}

model TradeTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resource   String   // METAL, GAS
  quantity   Int
  unitPrice  Int
  total      Int
  createdAt  DateTime @default(now())

  @@index([playerId, createdAt])
}

// A mission a pilot holds, one row each, up to MISSION_LIMITS per type (src/config/missions.js).
// `offer` holds the server-verified MissionOffer (proto JSON, snake_case) that was accepted, its
// `type` included, so no separate type column is kept.
model PlayerMission {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId        String
  originStationId  String
  offer            Json
  acceptedAt       DateTime @default(now())

  // Also serves lookups by player alone (its leading column).
  @@unique([playerId, missionId])
}

// Per-player, per-station cooldown started when a mission from that station completes or is
// abandoned. `completedAt` is when the latest one started; `availableAt` is when it ends, null on rows
// written before abandons had cooldowns of their own (those end MISSION_COOLDOWN_MS after completedAt).
model MissionCooldown {
  id               String    @id @default(uuid()) @db.Uuid
  playerId         String    @db.Uuid
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  originStationId  String
  completedAt      DateTime  @default(now())
  availableAt      DateTime?

  @@unique([playerId, originStationId])
}

// Payout ledger; the unique key enforces a single payout per (player, mission). `reputationChange`
// is the engine-signed value applied to the sponsoring faction (negative for a late completion).
model CompletedMission {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId        String
  factionId        String   @default("independent")
  rewardCredits    Int
  reputationChange Int      @default(0)
  completedAt      DateTime @default(now())

  @@unique([playerId, missionId])
  @@index([playerId, completedAt])
}

// One row per mission abandoned; the unique key means a mission is abandoned (and penalised) once,
// and an abandoned mission is never accepted again. `reputationLoss` is the delta applied (0 or
// negative). `reason`: in_port_origin, in_port_dock or in_flight (hostage_returned is reserved for
// the passenger hostage drop-off).
model AbandonedMission {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String   @db.Uuid
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId       String
  originStationId String
  factionId       String
  missionType     String   // PASSAGE, RESEARCH, GATHER
  reputationLoss  Int
  hostageMinutes  Int      @default(0)
  abandonedAt     DateTime @default(now())
  reason          String

  @@unique([playerId, missionId])
  @@index([playerId, abandonedAt])
}

// The pilot's standing with each faction, bounded to [-1000, 1000] (src/lib/reputation.js). No row
// means neutral (0).
model PlayerReputation {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  factionId String
  standing  Int      @default(0)
  updatedAt DateTime @updatedAt

  // Also serves lookups by player alone (its leading column).
  @@unique([playerId, factionId])
}

// One row per cargo lease issued (POST /game/cargo/lease). The pilot's hold is `lots` of the highest
// generation; no row means an empty hold. A lease keeps the engine session bound to it by its first
// applied write and the last seq applied, so records of that lineage can still be credited after a
// newer lease fences it (src/lib/cargo.js, applyCargoWrite).
model CargoLease {
  id         String   @id @db.Uuid  // lease_id, signed into the token and into every engine record
  playerId   String   @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  generation Int      // 1, 2, 3 ... per player; the highest is current
  sessionId  Bytes?   // 16-byte engine session id bound by the first applied write
  lastSeq    BigInt   @default(0)
  lots       Json     // [{ resource_type, units_milli, grade, purity_bp }] as of lastSeq (or as issued)
  issuedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([playerId, generation])
}

// A credited sale. The engine's nonce is unique, so a replay answers with the first result.
model CargoSale {
  id           String   @id @default(uuid()) @db.Uuid
  playerId     String   @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  nonce        Bytes    @unique // SaleRecord.nonce (16 bytes)
  leaseId      String   @db.Uuid
  seq          BigInt
  stationId    String
  items        Json     // sold lots, as signed (stored form)
  totalCredits Int
  soldAtMs     BigInt
  creditedAt   DateTime @default(now())

  @@index([playerId, creditedAt])
}

model PlanetChart {
  id            String    @id @default(uuid()) @db.Uuid
  playerId      String    @db.Uuid
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  planetId      String
  systemH3      String    @db.VarChar(15)
  completedAtMs BigInt
  signature     String    // base64-encoded 64-byte Ed25519 signature
  surveyJson    Json      // full survey revealed at 100%
  soldAt        DateTime?
  discoveredAt  DateTime  @default(now())

  @@unique([playerId, planetId])
  @@index([playerId, systemH3])
}

model SystemChart {
  id                 String    @id @default(uuid()) @db.Uuid
  playerId           String    @db.Uuid
  player             Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  systemH3           String    @db.VarChar(15)
  totalBodiesCharted Int
  chartedAtMs        BigInt
  signature          String    // base64-encoded 64-byte Ed25519 signature
  // 32-byte SHA-256 over the system's planet survey hashes, covered by the V2 signature. Null only
  // for charts claimed under V1.
  systemDigest       Bytes?
  soldAt             DateTime?
  discoveredAt       DateTime  @default(now())

  @@unique([playerId, systemH3])
  @@index([playerId])
}

// Better Auth session: the long-lived login that refresh-token families hang off.
model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          Player         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String         @unique
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_session")
}

// Better Auth account: one row per linked external identity (apple, google, play-games, ...).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  user                  Player    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // One provider identity can belong to only one player.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

// Better Auth verification records (OAuth state, one-time codes) for the social providers added later.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

// Binds an anonymous guest to the install that created it. Only a SHA-256 of the client-supplied
// device id is stored; the id itself is the guest's credential.
model GuestDevice {
  deviceHash String   @id
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// Rotating refresh tokens. A token is single-use: presenting one that was already rotated means
// the family was copied, so the whole family (and its session) is revoked.
model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  playerId  String      @db.Uuid
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}
