datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// The Better Auth `user` model (see src/lib/auth.js): the player id is the single stable identity,
// and `callsign` doubles as Better Auth's `name`.
model Player {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  // Argon2id (or a legacy SHA-256 digest awaiting upgrade). "!" matches no hash format, so guests
  // and dev-login pilots cannot sign in with a password.
  passwordHash String        @default("!")
  callsign     String        @unique
  emailVerified Boolean      @default(false)
  image        String?
  // True until the guest links a real account; email is then a placeholder.
  isAnonymous  Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  harbor       SpaceHarbor?
  session      GameSession?
  spaceships   Spaceship[]
  credits      Int           @default(0)
  // Set when development login grants the pilot its one-time starting credits; never granted twice.
  devCreditsGrantedAt DateTime?
  trades       TradeTransaction[]
  activeMissions   PlayerMission[]
  missionCooldowns MissionCooldown[]
  completedMissions CompletedMission[]
  abandonedMissions AbandonedMission[]
  reputations  PlayerReputation[]
  reputationLedger ReputationLedger[]
  // The faction whose colors the pilot flies (src/config/factions.js FACTION_IDS), or null. Set while
  // docked by POST /game/factions/colors; cleared when the standing with it falls below 500.
  activeColorsFactionId String?
  cargoLeases  CargoLease[]
  cargoSales   CargoSale[]
  planetCharts PlanetChart[]
  systemCharts SystemChart[]
  authSessions AuthSession[]
  accounts     Account[]
  refreshTokens RefreshToken[]
  guestDevice  GuestDevice?
  captain      Captain?
  crewMembers  CrewMember[]
  retiredCaptains RetiredCaptain[]
}

// The pilot's one Captain (src/config/captain.js), created at Level 1 the first time the pilot logs in
// or its ship is next locked (src/lib/captain.js), so existing pilots need no backfill. `level` is
// always levelForXp(xp); `unlockedTraits` is the array of trait ids spent, at most one per level above 1.
// `originType`, `promotedFromCrewId`, `innateClass`, `innateRank` and `quirkId` are set when a retiring
// captain is succeeded by a promoted crew member (POST /game/captain/retire) and stay at their
// defaults otherwise.
model Captain {
  id                 String   @id @default(uuid()) @db.Uuid
  playerId           String   @unique @db.Uuid
  player             Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  name               String
  level              Int      @default(1)
  xp                 Int      @default(0)
  unlockedTraits     Json     @default("[]")
  originType         String   @default("STARTER") // STARTER, ACADEMY_RECRUIT, PROMOTED_CREW
  promotedFromCrewId String?  @db.Uuid
  innateClass        String?
  innateRank         String?
  quirkId            String?
  juryRigComponentTypes Json  @default("[]") // an innate Engineer's overdriven components
  missionsCompleted  Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// A captain retired by POST /game/captain/retire (src/lib/retirement.js), kept for good: nothing deletes
// a row but the pilot's own account. It snapshots the captain as it left: `unlockedTraits`, the
// `capstoneTraitId` among them, the faction standings and `primaryFactionId` at retirement, the dock it
// retired at, and the promoted-crew origin it came in with. `legacyDoctrineId` is the one Legacy Doctrine
// its slot holds (honors and master retirements only; null until chosen) and `activeDoctrine` whether
// it is in force; at most MAX_ACTIVE_LEGACY_DOCTRINES rows per pilot are active. `assignmentStatus` and
// `assignedSpaceshipId` are hooks for fleet features not built yet. `receiptNonce` is the nonce of the
// docked receipt the retirement was made with, so a retried request is answered, not repeated.
model RetiredCaptain {
  id                       String   @id @default(uuid()) @db.Uuid
  playerId                 String   @db.Uuid
  player                   Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  name                     String
  originType               String   @default("STARTER")
  promotedFromCrewId       String?  @db.Uuid
  innateClass              String?
  innateRank               String?
  quirkId                  String?
  finalLevel               Int
  finalXp                  Int
  retirementTier           String   // EARLY_DISCHARGE, HONORS, MASTER
  missionsCompleted        Int
  unlockedTraits           Json
  capstoneTraitId          String?  // H6_FLEET_CAPTAIN, S6_ASTROGATOR_PRIME, C6_SHADOW_BROKER
  legacyDoctrineId         String?
  activeDoctrine           Boolean  @default(false)
  factionStandingsSnapshot Json     @default("{}")
  primaryFactionId         String?
  retiredAtStationId       String?
  retiredAtSystemH3        String?
  assignmentStatus         String   @default("RETIRED_IDLE")
  assignedSpaceshipId      String?  @db.Uuid
  receiptNonce             String?
  retiredAt                DateTime @default(now())

  @@unique([playerId, receiptNonce])
  @@index([playerId, activeDoctrine])
  @@index([playerId, assignmentStatus])
}

// A crew member hired from a station board (src/config/crew.js, src/lib/crew-generator.js). ACTIVE
// crew are aboard `spaceshipId`; active and STANDBY crew above zero morale share payouts. STANDBY crew are on the
// roster with no ship and no berth. `quirkId` is fixed at hire and `rank` changes only by promotion
// (POST /game/crew/promote); `wageShareBp` is the rank's base share, the effective
// share (quirk, captain traits) being derived when a payout settles. `morale`, `seniorityXp`,
// `unutilizedStreak` and `unpaidArrearsCredits` are kept by the settlements that pay the crew
// (src/lib/crew.js). `sourceCandidateId` is the board candidate the member was hired
// as: the board leaves that candidate out and refuses a second hire of them while the member is on
// the roster. It is null on members hired before it existed, who never match a candidate. It is not
// unique: a unique index would make `db push` demand --accept-data-loss, and hires are already
// serialised per pilot by the lock in lockActiveShip.
model CrewMember {
  id                   String     @id @default(uuid()) @db.Uuid
  playerId             String     @db.Uuid
  player               Player     @relation(fields: [playerId], references: [id], onDelete: Cascade)
  spaceshipId          String?    @db.Uuid
  spaceship            Spaceship? @relation(fields: [spaceshipId], references: [id], onDelete: SetNull)
  name                 String
  crewClass            String     // PILOT, NAVIGATOR, SCIENCE, ENGINEER, CHEF, DOCTOR, GUNNER
  rank                 String     // NOVICE, ADEPT, MASTER
  quirkId              String     // Q01..Q20
  status               String     @default("ACTIVE") // ACTIVE, STANDBY
  morale               Int        @default(75)
  seniorityXp          Int        @default(0)
  wageShareBp          Int        @default(500)
  unutilizedStreak     Int        @default(0)
  unpaidArrearsCredits Int        @default(0)
  // A stipend deferred while a morale-zero member awaits explicit shore-leave consent.
  pendingStipendCredits Int       @default(0)
  // Dock-configured Engineer overdrive; operation only, never persisted component upgrades.
  juryRigComponentTypes Json     @default("[]")
  homeFactionId        String     @default("independent")
  hiredAtStationId     String
  sourceCandidateId    String?
  hiredAt              DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  @@index([playerId, status])
  @@index([spaceshipId])
}

model SpaceHarbor {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Geographical representation for real-world home anchor points [1, 2]
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  h3Index    String   @db.VarChar(15) // Uber H3 Resolution 8 or 9 index string

  level      Int      @default(1)
  metalStock Float    @default(0.0)
  gasStock   Float    @default(0.0)
  updatedAt  DateTime @updatedAt
}

model GameSession {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rtseHost   String   // Internal domain/service of the allocated RTSE instance [3]
  connected  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Spaceship {
  id         String                @id @default(uuid()) @db.Uuid
  playerId   String                @db.Uuid
  player     Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  callsign   String
  active     Boolean               @default(true)
  // Passengers currently aboard; bounded by the life support's passenger_capacity (never above it).
  passengersAboard Int             @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  components ShipComponentRecord[]
  // The crew aboard (status ACTIVE); a crew member on STANDBY has no ship.
  crewMembers CrewMember[]
  // Shore leave (src/config/crew-morale.js): undocked flight time since the crew last had leave, the
  // dock where leave was last granted and when. Additive; existing ships start with none.
  flightMsSinceLeave Int       @default(0)
  lastLeaveStationId String?
  lastLeaveAt        DateTime?
  // Consecutive signed docking times approximate flight until receipts carry an undock time.
  lastCrewDockedAtMs BigInt?
  crewPayoutSinceDock Boolean @default(false) // legacy compatibility; timestamps govern new settlements
  lastCrewPayoutAtMs BigInt?
  shoreLeaveStations CrewShoreLeave[]
}

// Recovery is throttled per station, not merely at the most recently visited dock (A-B-A).
model CrewShoreLeave {
  spaceshipId String @db.Uuid
  spaceship Spaceship @relation(fields: [spaceshipId], references: [id], onDelete: Cascade)
  stationId String
  lastLeaveAtMs BigInt

  @@id([spaceshipId, stationId])
}

model ShipComponentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  spaceshipId String    @db.Uuid
  spaceship   Spaceship @relation(fields: [spaceshipId], references: [id], onDelete: Cascade)
  type        String    // HULL, RADAR, CARGO, STEALTH, SHIELDS, WEAPONS, ENERGY, COMMS, ENGINES
  tier        Int       @default(1)
  healthPct   Int       @default(100)
  updatedAt   DateTime  @updatedAt

  @@unique([spaceshipId, type])
}

model TradeTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resource   String   // METAL, GAS
  quantity   Int
  unitPrice  Int
  total      Int
  createdAt  DateTime @default(now())

  @@index([playerId, createdAt])
}

// A mission a pilot holds, one row each, up to MISSION_LIMITS per type (src/config/missions.js).
// `offer` holds the server-verified MissionOffer (proto JSON, snake_case) that was accepted, its
// `type` included, so no separate type column is kept.
model PlayerMission {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId        String
  originStationId  String
  offer            Json
  acceptedAt       DateTime @default(now())

  // Also serves lookups by player alone (its leading column).
  @@unique([playerId, missionId])
}

// Per-player, per-station cooldown started when a mission from that station completes or is
// abandoned. `completedAt` is when the latest one started; `availableAt` is when it ends, null on rows
// written before abandons had cooldowns of their own (those end MISSION_COOLDOWN_MS after completedAt).
model MissionCooldown {
  id               String    @id @default(uuid()) @db.Uuid
  playerId         String    @db.Uuid
  player           Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  originStationId  String
  completedAt      DateTime  @default(now())
  availableAt      DateTime?

  @@unique([playerId, originStationId])
}

// Payout ledger; the unique key enforces a single payout per (player, mission). `reputationChange`
// is the engine-signed value for the sponsoring faction (negative for a late completion); the change
// applied, with any Flying Colors bonus and caps, is in ReputationLedger.
model CompletedMission {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId        String
  factionId        String   @default("independent")
  rewardCredits    Int
  reputationChange Int      @default(0)
  completedAt      DateTime @default(now())

  @@unique([playerId, missionId])
  @@index([playerId, completedAt])
}

// One row per mission abandoned; the unique key means a mission is abandoned (and penalised) once,
// and an abandoned mission is never accepted again. `reputationLoss` is the delta applied (0 or
// negative). `reason`: in_port_origin, in_port_dock or in_flight (hostage_returned is reserved for
// the passenger hostage drop-off).
model AbandonedMission {
  id              String   @id @default(uuid()) @db.Uuid
  playerId        String   @db.Uuid
  player          Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId       String
  originStationId String
  factionId       String
  missionType     String   // PASSAGE, RESEARCH, GATHER
  reputationLoss  Int
  hostageMinutes  Int      @default(0)
  abandonedAt     DateTime @default(now())
  reason          String

  @@unique([playerId, missionId])
  @@index([playerId, abandonedAt])
}

// The pilot's standing with each faction, bounded to [-1000, 1000] (src/lib/reputation.js), and
// with alpha, beta and gamma also under the rival and single-Paragon caps (src/config/factions.js).
// No row means neutral (0).
model PlayerReputation {
  id        String   @id @default(uuid()) @db.Uuid
  playerId  String   @db.Uuid
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  factionId String
  standing  Int      @default(0)
  updatedAt DateTime @updatedAt

  // Also serves lookups by player alone (its leading column).
  @@unique([playerId, factionId])
}

// Append-only audit of every standing change (src/lib/reputation.js). `factionId` is the faction the
// event was for and `factionDelta` its change; `alphaDelta`, `betaDelta` and `gammaDelta` are the
// changes to the three factions, including those their caps made. `reason`: MISSION_COMPLETED,
// COMPLETE_COVERT_CLEAN, COMPLETE_COVERT_DETECTED,
// MISSION_ABANDONED or RENOUNCE_PARAGON. `bribePaidCredits` is reserved for customs bribes.
model ReputationLedger {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId        String?
  reason           String
  factionId        String?
  factionDelta     Int      @default(0)
  alphaDelta       Int      @default(0)
  betaDelta        Int      @default(0)
  gammaDelta       Int      @default(0)
  bribePaidCredits Int      @default(0)
  createdAt        DateTime @default(now())

  @@index([playerId, createdAt])
}

// One row per cargo lease issued (POST /game/cargo/lease). The pilot's hold is `lots` of the highest
// generation; no row means an empty hold. A lease keeps the engine session bound to it by its first
// applied write and the last seq applied, so records of that lineage can still be credited after a
// newer lease fences it (src/lib/cargo.js, applyCargoWrite).
model CargoLease {
  id         String   @id @db.Uuid  // lease_id, signed into the token and into every engine record
  playerId   String   @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  generation Int      // 1, 2, 3 ... per player; the highest is current
  sessionId  Bytes?   // 16-byte engine session id bound by the first applied write
  lastSeq    BigInt   @default(0)
  lots       Json     // [{ resource_type, units_milli, grade, purity_bp }] as of lastSeq (or as issued)
  issuedAt   DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([playerId, generation])
}

// A credited sale. The engine's nonce is unique, so a replay answers with the first result.
model CargoSale {
  id           String   @id @default(uuid()) @db.Uuid
  playerId     String   @db.Uuid
  player       Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  nonce        Bytes    @unique // SaleRecord.nonce (16 bytes)
  leaseId      String   @db.Uuid
  seq          BigInt
  stationId    String
  items        Json     // sold lots, as signed (stored form)
  totalCredits Int      // gross: what the engine signed, before the crew's share
  // The crew's share of totalCredits taken when the sale was credited; 0 on sales from before crew,
  // so a replay answers with the same split the first credit made.
  crewShareCredits Int  @default(0)
  soldAtMs     BigInt
  creditedAt   DateTime @default(now())

  @@index([playerId, creditedAt])
}

model PlanetChart {
  id            String    @id @default(uuid()) @db.Uuid
  playerId      String    @db.Uuid
  player        Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  planetId      String
  systemH3      String    @db.VarChar(15)
  completedAtMs BigInt
  signature     String    // base64-encoded 64-byte Ed25519 signature
  surveyJson    Json      // full survey revealed at 100%
  soldAt        DateTime?
  discoveredAt  DateTime  @default(now())

  @@unique([playerId, planetId])
  @@index([playerId, systemH3])
}

model SystemChart {
  id                 String    @id @default(uuid()) @db.Uuid
  playerId           String    @db.Uuid
  player             Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  systemH3           String    @db.VarChar(15)
  totalBodiesCharted Int
  chartedAtMs        BigInt
  signature          String    // base64-encoded 64-byte Ed25519 signature
  // 32-byte SHA-256 over the system's planet survey hashes, covered by the V2 signature. Null only
  // for charts claimed under V1.
  systemDigest       Bytes?
  soldAt             DateTime?
  discoveredAt       DateTime  @default(now())

  @@unique([playerId, systemH3])
  @@index([playerId])
}

// Better Auth session: the long-lived login that refresh-token families hang off.
model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  user          Player         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token         String         @unique
  expiresAt     DateTime
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@index([userId])
  @@map("auth_session")
}

// Better Auth account: one row per linked external identity (apple, google, play-games, ...).
model Account {
  id                    String    @id @default(uuid()) @db.Uuid
  userId                String    @db.Uuid
  user                  Player    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // One provider identity can belong to only one player.
  @@unique([providerId, accountId])
  @@index([userId])
  @@map("auth_account")
}

// Better Auth verification records (OAuth state, one-time codes) for the social providers added later.
model Verification {
  id         String   @id @default(uuid()) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("auth_verification")
}

// Binds an anonymous guest to the install that created it. Only a SHA-256 of the client-supplied
// device id is stored; the id itself is the guest's credential.
model GuestDevice {
  deviceHash String   @id
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

// Rotating refresh tokens. A token is single-use: presenting one that was already rotated means
// the family was copied, so the whole family (and its session) is revoked.
model RefreshToken {
  id        String      @id @default(uuid()) @db.Uuid
  playerId  String      @db.Uuid
  player    Player      @relation(fields: [playerId], references: [id], onDelete: Cascade)
  sessionId String      @db.Uuid
  session   AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String      @unique
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}
