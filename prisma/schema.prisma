datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model Player {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  passwordHash String
  callsign     String        @unique
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  harbor       SpaceHarbor?
  session      GameSession?
  spaceships   Spaceship[]
  credits      Int           @default(0)
  trades       TradeTransaction[]
  activeMission    PlayerMission?
  missionCooldowns MissionCooldown[]
  completedMissions CompletedMission[]
}

model SpaceHarbor {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  
  // Geographical representation for real-world home anchor points [1, 2]
  latitude   Float    @db.DoublePrecision
  longitude  Float    @db.DoublePrecision
  h3Index    String   @db.VarChar(15) // Uber H3 Resolution 8 or 9 index string

  level      Int      @default(1)
  metalStock Float    @default(0.0)
  gasStock   Float    @default(0.0)
  updatedAt  DateTime @updatedAt
}

model GameSession {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @unique @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  rtseHost   String   // Internal domain/service of the allocated RTSE instance [3]
  connected  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
}

model Spaceship {
  id         String                @id @default(uuid()) @db.Uuid
  playerId   String                @db.Uuid
  player     Player                @relation(fields: [playerId], references: [id], onDelete: Cascade)
  callsign   String
  active     Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  components ShipComponentRecord[]
}

model ShipComponentRecord {
  id          String    @id @default(uuid()) @db.Uuid
  spaceshipId String    @db.Uuid
  spaceship   Spaceship @relation(fields: [spaceshipId], references: [id], onDelete: Cascade)
  type        String    // HULL, RADAR, CARGO, STEALTH, SHIELDS, WEAPONS, ENERGY, COMMS, ENGINES
  tier        Int       @default(1)
  healthPct   Int       @default(100)
  updatedAt   DateTime  @updatedAt

  @@unique([spaceshipId, type])
}

model TradeTransaction {
  id         String   @id @default(uuid()) @db.Uuid
  playerId   String   @db.Uuid
  player     Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  resource   String   // METAL, GAS
  quantity   Int
  unitPrice  Int
  total      Int
  createdAt  DateTime @default(now())

  @@index([playerId, createdAt])
}

// A pilot's single active mission. `offer` holds the server-verified
// MissionOffer (proto JSON, snake_case) that was accepted.
model PlayerMission {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @unique @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId        String
  originStationId  String
  offer            Json
  acceptedAt       DateTime @default(now())
}

// Per-player, per-station cooldown started when a mission from that station completes.
model MissionCooldown {
  id               String   @id @default(uuid()) @db.Uuid
  playerId         String   @db.Uuid
  player           Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  originStationId  String
  completedAt      DateTime @default(now())

  @@unique([playerId, originStationId])
}

// Payout ledger; the unique key enforces a single payout per (player, mission).
model CompletedMission {
  id            String   @id @default(uuid()) @db.Uuid
  playerId      String   @db.Uuid
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  missionId     String
  rewardCredits Int
  completedAt   DateTime @default(now())

  @@unique([playerId, missionId])
}
