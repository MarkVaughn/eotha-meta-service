DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotha_meta?schema=public"
PORT=3000
NODE_ENV=development
# Optional overrides (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# SESSION_TTL_DAYS=90
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=   # defaults to a key derived from keys/private.pem
# Public key that engine-signed claims (missions, charts) verify against. Not the login key.
# CLAIM_PUBLIC_KEY=   # 64 hex characters: the raw Ed25519 public key matching the engine's RTSE_EXPLORATION_SEED
# CLAIM_PUBLIC_KEY_FILE=   # or a file holding that hex or a PEM public key
