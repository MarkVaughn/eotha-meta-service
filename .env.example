DATABASE_URL="postgresql://postgres:postgres@localhost:5432/eotha_meta?schema=public"
PORT=3000
NODE_ENV=development
# Optional overrides (defaults shown)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_DAYS=30
# SESSION_TTL_DAYS=90
# DEV_STARTING_CREDITS=20000   # one-time credits for a new /auth/dev-login pilot (development only)
# BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_SECRET=   # defaults to a key derived from keys/private.pem
# Public key that engine-signed claims (missions, charts) verify against. Not the login key.
# CLAIM_PUBLIC_KEY=   # 64 hex characters: the raw Ed25519 public key matching the engine's RTSE_EXPLORATION_SEED
# CLAIM_PUBLIC_KEY_FILE=   # or a file holding that hex or a PEM public key
# Private RTSE control-plane auth. Set a random 32+ character development credential, or configure
# verified TLS client-certificate SHA-256 fingerprints in production (comma separated).
# INTERNAL_RTSE_CREDENTIAL=
# INTERNAL_RTSE_MTLS_FINGERPRINTS=
# Key id that RTSE's provisioned enforcement-projection key ring associates with keys/public.pem.
# ENFORCEMENT_ISSUER_KEY_ID=eotha-meta-service-v1
# Fixed WebSocket URL of the RTSE gateway handed to clients (a staging host, say): ws:// or wss://, no credentials.
# Unset, it is ws://localhost:8080/session. It is never derived from the request; over the ngrok tunnel the
# dev client derives the address from its tunnel base itself.
# GATEWAY_WS_URL=wss://gateway.example.com/session
